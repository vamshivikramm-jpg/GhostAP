# GhostAP as a systemd service (F071). Install with: sudo tools/install_service.sh
# Settings: /etc/ghostap/ghostap.env (interface, channel, address, token, secrets).
[Unit]
Description=GhostAP passive evil twin detector
Documentation=file:///opt/ghostap/docs/DEPLOY.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=ghostap
Group=ghostap
WorkingDirectory=/opt/ghostap
EnvironmentFile=/etc/ghostap/ghostap.env
# Monitor mode needs root once, before the capture starts ("+" = run this step with full privileges).
ExecStartPre=+/opt/ghostap/tools/kali_monitor.sh start ${GHOSTAP_IFACE} ${GHOSTAP_CHANNEL}
ExecStart=/opt/ghostap/.venv/bin/python -m ghostap.web --iface ${GHOSTAP_IFACE} --host ${GHOSTAP_HOST} --port ${GHOSTAP_PORT} $GHOSTAP_ARGS
ExecStopPost=+/opt/ghostap/tools/kali_monitor.sh stop ${GHOSTAP_IFACE}
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

# Only what a passive capture needs: raw sockets to receive, network admin for channel hopping.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/ghostap/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
