# /etc/ghostap/ghostap.env (mode 600, owner root). Read by the systemd service.
GHOSTAP_IFACE=wlan1
GHOSTAP_CHANNEL=6
# 127.0.0.1 = only this machine; 0.0.0.0 = the network (sign-in and --https recommended)
GHOSTAP_HOST=127.0.0.1
GHOSTAP_PORT=8050
# extra options, e.g. channel hopping and HTTPS:
GHOSTAP_ARGS=--hop 1,6,11 --https
# fixed start-up token for network access (otherwise a new one is printed in the journal at each start)
#GHOSTAP_TOKEN=
# secrets named in config.yaml notifications (examples):
#GHOSTAP_SMTP_PASSWORD=
#GHOSTAP_NTFY_URL=
